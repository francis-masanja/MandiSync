# .env.example - Copy this file to .env and fill in your values

# Database
# The app reads DATABASE_URL. When it is unset or empty, MandiSync uses the
# in-memory demo dataset (no database required).
# Local SQLite via Prisma: DATABASE_URL="file:./prisma/dev.db"
# Turso:                  DATABASE_URL="libsql://your-db.turso.io"
DATABASE_URL=""

# Turso auth token (only needed when DATABASE_URL points at Turso)
TURSO_AUTH_TOKEN=""

# NextAuth Configuration
# Generate a secure secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-32-byte-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# QR gate pass signing (optional; falls back to NEXTAUTH_SECRET)
MANDI_HMAC_SECRET=""

# Public site URL for social metadata (optional; Vercel uses VERCEL_URL)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
