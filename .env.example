# .env.example - Copy this file to .env and fill in your values

# Database (Turso / SQLite)
# For local development: "file:./dev.db"
# For production Turso: "libsql://your-db.turso.io?authToken=YOUR_AUTH_TOKEN"
# Turso Database (split for security - auth token never in URL)
TURSO_DATABASE_URL="libsql://your-db.turso.i"
TURSO_AUTH_TOKEN=""


# NextAuth Configuration
# Generate a secure secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-32-byte-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Ollama Configuration
# For local: http://localhost:11434
# For Ollama Cloud: https://your-ollama-cloud-instance.com
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Optional: Ollama Cloud API Key (if using authenticated cloud instance)
# OLLAMA_API_KEY="your-ollama-cloud-api-key"
