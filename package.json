{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "license": "MIT",
  "author": "",
  "type": "module",
  "overrides": {
    "postcss": "^8.5.23",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "type-check": "tsc --noEmit",
    "prepare": "npm run lint",
    "rotate:turso-token": "tsx scripts/rotate-turso-token.ts",
    "prebuild": "node -e \"const fs=require('fs'); const c=fs.readFileSync('lib/crypto.ts','utf8'); if(c.includes('mandisync_production_master_secret_2026')){console.error('❌ Hardcoded HMAC secret detected in lib/crypto.ts'); process.exit(1);} const f=fs.readFileSync('components/FirmwareView.tsx','utf8'); if(f.includes('MANDISYNC_HMAC_MASTER_KEY_2026') || f.includes('ApmcSecurePassword123') || f.includes('MANDI_WIFI_MESH')){console.error('❌ Hardcoded firmware secret detected in components/FirmwareView.tsx'); process.exit(1);}\"",
    "secrets:scan": "gitleaks detect --source . --verbose"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "postcss": "^8.5.23",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "prisma": "^7.10.0",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
